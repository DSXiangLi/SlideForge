# ─────────────────────────────────────────────────────────────
# SlideForge 生图配置（可选文件）
#
# 这个文件是可选的 fallback 配置源：**进程环境变量优先于本文件**。
# 本文件不会被提交（.env 已在仓库 .gitignore 中）。示例见 .env.example。
#
# 查找顺序（只读第一个存在的文件，键不跨文件合并）：
#   1. ./.env                       （进程工作目录；经 adapter 调用时 = deck 目录）
#   2. <技能目录>/.env               （如 ~/.agents/skills/SlideForge/.env）
#   3. ~/.slideforge/.env            （用户级配置）
#
# 先跑一次自检（不联网、不计费）：
#   python3 <技能目录>/scripts/providers/openai_image.py --self-check
# ─────────────────────────────────────────────────────────────

# 必填：OpenAI 密钥。只有 AI 插画 / 整页烙入才用得到，主流程不需要。
OPENAI_API_KEY=（把你在 OpenAI 平台申请到的 key 填在这里；本行只是模板）

# 可选：接口基址，默认 OpenAI 官方；兼容端点可改（如自建网关 / 代理）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：生图模型，默认 gpt-image-2
#   技能的图片门禁要求页级槽位 ≥2560×1440，只有 gpt-image-2 能原生给出该尺寸；
#   gpt-image-1 系只有 1024x1024 / 1536x1024 / 1024x1536 三档。
# OPENAI_IMAGE_MODEL=gpt-image-2

# 可选：--advance-model（advanced 档）使用的模型；留空则与 OPENAI_IMAGE_MODEL 相同
# OPENAI_IMAGE_MODEL_ADVANCED=

# 可选：参考图编辑保真度（仅 /images/edits 生效）：high / low
# OPENAI_INPUT_FIDELITY=high

# 可选：其它 OpenAI 兼容端点的兼容开关（按需，默认全部交给端点自证）
# OPENAI_SIZE_PRESET=auto
# OPENAI_QUALITY=auto
# OPENAI_OUTPUT_FORMAT=png
# OPENAI_BACKGROUND=auto
# OPENAI_MODERATION=auto
