    {
      "slide_id": "how",
      "render_mode": "html",
      "chapter": "怎么做",
      "texts": [
        {
          "role": "body",
          "content": "02 · HOW",
          "line_count": 1,
          "advance_width": 1680
        },
        {
          "role": "title",
          "content": "三段式系统：生成、编辑、桥接",
          "line_count": 1,
          "advance_width": 1680
        },
        {
          "role": "body",
          "content": "生成技能",
          "line_count": 1,
          "advance_width": 448.7
        },
        {
          "role": "body",
          "content": "从简报到 HTML：先脑暴冻结需求，再按主题落码，双闸验收把关质量。",
          "line_count": 2,
          "advance_width": 448.7
        },
        {
          "role": "body",
          "content": "单文件编辑器",
          "line_count": 1,
          "advance_width": 448.7
        },
        {
          "role": "body",
          "content": "在页面里就地改文字、换图片，保存直接写回 HTML 文件本身。",
          "line_count": 2,
          "advance_width": 448.7
        },
        {
          "role": "body",
          "content": "本地桥",
          "line_count": 1,
          "advance_width": 448.7
        },
        {
          "role": "body",
          "content": "编辑器与 AI 之间的托管通道：隔离工作副本、验证证据、正式发布。",
          "line_count": 2,
          "advance_width": 448.7
        },
        {
          "role": "body",
          "content": "三者围绕同一个约定工作：文件是唯一事实源，标记是唯一协议。",
          "line_count": 1,
          "advance_width": 1680
        },
        {
          "role": "furniture",
          "content": "HTML PPTX",
          "line_count": 1,
          "advance_width": 98.3
        },
        {
          "role": "furniture",
          "content": "PAGE 03",
          "line_count": 1,
          "advance_width": 76.5
        }
