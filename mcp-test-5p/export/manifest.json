      "texts": [
        {
          "role": "body",
          "content": "01 · WHY",
          "line_count": 1,
          "advance_width": 1680
        },
        {
          "role": "title",
          "content": "传统 PPT 交付的三个断层",
          "line_count": 1,
          "advance_width": 1680
        },
        {
          "role": "body",
          "content": "不可改",
          "line_count": 1,
          "advance_width": 714
        },
        {
          "role": "body",
          "content": "二进制格式把内容锁在源软件里——改一处措辞，也要回到原工具重新导出。",
          "line_count": 1,
          "advance_width": 714
        },
        {
          "role": "body",
          "content": "不可验",
          "line_count": 1,
          "advance_width": 693
        },
        {
          "role": "body",
          "content": "排版溢出、字体缺失、比例失调，往往要到演讲现场投影时才第一次暴露。",
          "line_count": 1,
          "advance_width": 693
        },
        {
          "role": "body",
          "content": "不可嵌",
          "line_count": 1,
          "advance_width": 742
        },
        {
          "role": "body",
          "content": "它进不了网页与文档流——不能 iframe 嵌入，不能版本管理，不能被程序处理。",
          "line_count": 1,
          "advance_width": 742
        },
        {
          "role": "furniture",
          "content": "HTML PPTX",
          "line_count": 1,
          "advance_width": 98.3
        },
        {
          "role": "furniture",
          "content": "PAGE 02",
          "line_count": 1,
          "advance_width": 76.5
        }
      ],
